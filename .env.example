# ---------------------------------------------------------------------------
# Waresport Sales Hub — environment template. Copy to `.env.local`:
#   cp .env.example .env.local
# Every value below is a local-development placeholder. Replace all secrets
# before deploying anywhere real.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# DATABASE_URL is the owning (privileged) connection used by migrations, the
# sign-in/invite-claim flows, and CLI scripts.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/waresport
# APP_DATABASE_URL is the request-scoped connection. This role is NOT a table
# owner and has NOBYPASSRLS, so every row level security policy applies to it.
# All business queries go through this connection.
APP_DATABASE_URL=postgres://waresport_app:waresport_app_dev@127.0.0.1:54329/waresport

# --- Authentication -------------------------------------------------------
# Generate a fresh value for every environment:  openssl rand -base64 48
AUTH_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
SESSION_TTL_HOURS=12
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
INVITE_TTL_HOURS=168

# Addresses allowed to bootstrap the first owner via `npm run bootstrap:owner`.
# This is an allowlist, not a password — the account still verifies by email.
OWNER_BOOTSTRAP_EMAILS=owner@waresport.local

# --- Email ----------------------------------------------------------------
# Development points at the local Mailpit capture server (docker compose).
# Nothing leaves the machine. Open http://127.0.0.1:54324 to read messages.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Waresport Sales Hub <no-reply@waresport.local>

# --- Import limits --------------------------------------------------------
IMPORT_MAX_FILE_BYTES=10000000
IMPORT_MAX_ROWS=50000

# --- Private file storage -------------------------------------------------
# Uploaded resource documents. Outside the web root; served only through an
# authorization-checked route.
STORAGE_DIR=./storage

# --- Authentication rate limits ------------------------------------------
# Strict by default. Raise only with a reason; the acceptance suite overrides
# them for its own run rather than weakening the defaults.
AUTH_REQUEST_LIMIT_PER_EMAIL=5
AUTH_REQUEST_LIMIT_PER_IP=20
AUTH_VERIFY_LIMIT_PER_EMAIL=10
AUTH_RATE_WINDOW_SECONDS=900
